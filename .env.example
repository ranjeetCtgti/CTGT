# API keys
SCRAPEDO_API_KEY=your_scrapedo_api_key
SERPER_API_KEY=your_serper_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite #gemma-4-31b-it
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL_ID=qwen/qwen3-32b

# Database
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/ctgt_leads

# Runtime settings
LOG_LEVEL=INFO
PIPELINE_PHASE=testing
LLM_PROVIDER=gemini
REQUEST_TIMEOUT_SECONDS=30
LLM_REQUESTS_PER_MINUTE=25
MAX_RETRIES=2
BATCH_SIZE=10

# Domain resolution in the main pipeline
ENRICHMENT_ENABLED=false
ENRICHMENT_PROVIDER=serper
ENRICHMENT_TIMEOUT_SECONDS=15
ENRICHMENT_MIN_DOMAIN_CONFIDENCE=0.75

# Lead enrichment auto-run after persisted signals
LEAD_ENRICHMENT_ENABLED=false
LEAD_ENRICHMENT_TIMEOUT_SECONDS=10
LEAD_ENRICHMENT_FRESHNESS_DAYS=7

# Lead enrichment providers
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
APOLLO_API_KEY=
HUNTER_API_KEY=

# Optional inputs
# CAREER_PAGE_TARGETS_CSV=data/career_page_targets.csv
# CAREER_PAGE_MAX_PAGES_PER_TARGET=4
